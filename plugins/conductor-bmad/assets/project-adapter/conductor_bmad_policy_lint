#!/usr/bin/env python3
"""CI-callable Factory BMAD policy lint using the shared authored policy."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True

import conductor_bmad_policy


def main() -> int:
    parser = argparse.ArgumentParser(description="Repository inventory by default; host checks require an explicit harness.")
    parser.add_argument("--harness", choices=("claude", "codex"))
    parser.add_argument("--route", choices=("native", "guarded-mcp"))
    args = parser.parse_args()
    if args.route and not args.harness:
        parser.error("--route requires --harness")
    payload = (conductor_bmad_policy.policy_lint(Path.cwd().resolve(), args.harness, args.route)
               if args.harness else conductor_bmad_policy.inventory_audit(Path.cwd().resolve(), "repository"))
    print(json.dumps(payload, sort_keys=True))
    return 0 if payload["state"] == "READY" else 2


if __name__ == "__main__":
    sys.exit(main())
