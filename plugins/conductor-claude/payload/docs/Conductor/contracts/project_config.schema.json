{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.dev/schemas/project_config.schema.json",
  "title": "Conductor Project Config",
  "description": "Single schema-locked per-repository configuration. Adapter-specific settings live under adapters.<name> and are validated by that adapter's own schema (docs/adapters/<name>/contracts/); the core schema only fixes their shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_name", "protected_roots", "allowed_harnesses", "default_budget", "agents_md", "required_docs", "recall"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "product_name": { "type": "string", "minLength": 1 },
    "protected_roots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowed_harnesses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["claude-code", "codex", "cursor"] } },
    "default_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "effort_g2", "effort_g3"],
      "properties": { "model": { "type": "string", "minLength": 1 }, "effort_g2": { "$ref": "#/$defs/effort" }, "effort_g3": { "$ref": "#/$defs/effort" } }
    },
    "agents_md": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["managed_block", "full_ownership"] },
        "project_owned_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "required_docs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "project_preflight": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" }, "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 } }
    },
    "recall": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger"],
      "properties": { "trigger": { "enum": ["always", "when_index_nonempty", "never"] } }
    },
    "adapters": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,31}$" },
      "additionalProperties": { "type": "object" },
      "description": "One entry per installed adapter, keyed by adapter name. Each value is validated by docs/adapters/<name>/contracts/<name>_adapter_config.schema.json."
    }
  }
}
