{
  "fixture_id": "REPOSITORY-SETUP",
  "constraints": ["C-01", "C-03", "C-11", "C-12"],
  "cases": [
    {
      "case_id": "GF-CLEAN",
      "state": "empty_git_repository",
      "operation": "greenfield_preview_then_apply",
      "expected_result": "PASS",
      "expected_reason_code": "FACTORY_SETUP_APPLIED",
      "must_preserve": [".git"],
      "must_create": ["AGENTS.md", "docs/Factory", "scripts/factoryctl"],
      "second_run_mutations": []
    },
    {
      "case_id": "BF-PRESERVE",
      "state": "existing_project_with_user_files",
      "operation": "brownfield_preview",
      "expected_result": "PASS",
      "expected_reason_code": "FACTORY_PLAN_READY",
      "mutations": [],
      "must_preserve": ["README.md", "src", "tests", "package.json"]
    },
    {
      "case_id": "BF-CONFLICT",
      "state": "existing_conflicting_agents_and_factory_files",
      "operation": "brownfield_apply",
      "expected_result": "HALT",
      "expected_reason_code": "FACTORY_CONFLICT_USER_OWNED",
      "mutations": [],
      "must_preserve": ["AGENTS.md", "docs/Factory/ORCHESTRATION.md"]
    },
    {
      "case_id": "PATH-SYMLINK",
      "state": "target_path_escapes_repository_via_symlink",
      "operation": "brownfield_apply",
      "expected_result": "HALT",
      "expected_reason_code": "FACTORY_UNSAFE_PATH",
      "mutations": []
    }
  ]
}
