#!/bin/sh
'''exec' "$(dirname "$0")/conductor-python" "$0" "$@"
' '''
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from conductor_contract_lint import (  # noqa: E402
    ContractLintError,
    format_result as format_contract_lint,
    lint_completion,
    lint_execution,
    lint_intent,
)
from conductor_gap import open_gap, resolve_gap  # noqa: E402
from conductor_postimage import capture as postimage_capture, compare as postimage_compare  # noqa: E402
from conductor_receipts import attest as receipts_attest, run_receipts  # noqa: E402
from conductor_context_index import (  # noqa: E402
    FactoryContextIndexError,
    build_context_index,
    describe_context,
    expand_context,
    format_context_describe,
    format_context_expand,
    format_context_recall,
    format_context_trace,
    recall_context,
    trace_context,
    write_context_report,
)
from conductor_execution_closeout import (  # noqa: E402
    ExecutionCloseoutError,
    record_closeout,
)
from conductor_host_capability import discover_artifact as discover_host_capabilities  # noqa: E402
from conductor_kilo_stage import (  # noqa: E402
    FactoryKiloStageError,
    format_kilo_stage,
    run_kilo_stage,
)
from conductor_pack_lint import (  # noqa: E402
    FactoryPackLintError,
    evaluate_host_capability_contract,
    format_pack_lint,
    lint_pack,
)
from conductor_project_preflight import (  # noqa: E402
    ProjectPreflightError,
    run_project_preflight,
    write_project_preflight_evidence,
)
from conductor_run_metrics import (  # noqa: E402
    FactoryRunMetricsError,
    format_run_metrics,
    init_run_metrics,
)
from conductor_stage_lint import (  # noqa: E402
    FactoryStageLintError,
    format_stage_lint,
    lint_stage,
)
from conductor_task_memory import (  # noqa: E402
    TaskMemoryError,
    bootstrap_task_memory,
    format_suggestion_text,
    log_task,
    review_task_memory,
    suggest_task,
)


REPO_ROOT = SCRIPT_DIR.parent


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="conductorctl",
        description="Factory continuity, context-recall, validation, and optional task-memory helper.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    memory_init_parser = subparsers.add_parser(
        "memory-init",
        help="Initialize optional task-memory directories, default runbooks, and journal.",
    )
    memory_init_parser.add_argument("--force", action="store_true", help="Rewrite default runbooks and clear journal.")
    memory_init_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    memory_suggest_parser = subparsers.add_parser(
        "memory-suggest",
        help="Classify a task and print the best runbook checklist.",
    )
    memory_suggest_parser.add_argument("--task", required=True, help="Task description to classify.")
    memory_suggest_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    memory_log_parser = subparsers.add_parser(
        "memory-log",
        help="Append one task outcome to the optional task-memory journal.",
    )
    memory_log_parser.add_argument("--task", required=True, help="Task description.")
    memory_log_parser.add_argument(
        "--outcome",
        required=True,
        choices=["success", "partial", "blocked"],
        help="Task result status.",
    )
    memory_log_parser.add_argument("--notes", default="", help="Short lessons learned or failure details.")
    memory_log_parser.add_argument("--runbook", default=None, help="Optional explicit runbook id.")
    memory_log_parser.add_argument("--duration-minutes", type=int, default=None, help="Optional duration in minutes.")
    memory_log_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    memory_review_parser = subparsers.add_parser(
        "memory-review",
        help="Summarize task-memory journal trends and optionally write a review report.",
    )
    memory_review_parser.add_argument("--no-write-report", action="store_true", help="Print summary without writing a markdown report.")
    memory_review_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    context_index_parser = subparsers.add_parser(
        "context-index",
        help="Build the Factory, Mission, and Product Owner artifact recall index.",
    )
    context_index_parser.add_argument("--db-path", default=None, help="Optional override for the SQLite index path.")
    context_index_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    context_recall_parser = subparsers.add_parser(
        "context-recall",
        help="Search indexed Factory, Mission, and Product Owner artifacts.",
    )
    context_recall_parser.add_argument("--query", required=True, help="Recall query.")
    context_recall_parser.add_argument("--scope", default=None, help="Optional path, run, phase, mission, or sprint filter.")
    context_recall_parser.add_argument("--limit", type=int, default=8, help="Maximum number of matches to return.")
    context_recall_parser.add_argument("--db-path", default=None, help="Optional override for the SQLite index path.")
    context_recall_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    context_trace_parser = subparsers.add_parser(
        "context-trace",
        help="Trace an exact identifier such as RUN_..., PHASE_..., Pxx-yy, C-..., or FP-....",
    )
    context_trace_parser.add_argument("--id", required=True, help="Identifier to trace.")
    context_trace_parser.add_argument("--scope", default=None, help="Optional path, run, phase, mission, or sprint filter.")
    context_trace_parser.add_argument("--db-path", default=None, help="Optional override for the SQLite index path.")
    context_trace_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    context_expand_parser = subparsers.add_parser(
        "context-expand",
        help="Expand one indexed chunk by numeric chunk id or one indexed source by path.",
    )
    context_expand_parser.add_argument("--ref", required=True, help="Chunk id or indexed source path.")
    context_expand_parser.add_argument("--db-path", default=None, help="Optional override for the SQLite index path.")
    context_expand_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    context_describe_parser = subparsers.add_parser(
        "context-describe",
        help="Describe indexed source coverage by artifact type and scope.",
    )
    context_describe_parser.add_argument("--scope", default=None, help="Optional path, run, phase, mission, or sprint filter.")
    context_describe_parser.add_argument("--db-path", default=None, help="Optional override for the SQLite index path.")
    context_describe_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    context_report_parser = subparsers.add_parser(
        "context-report",
        help="Generate a scoped context recall report artifact for Factory, PO, or Mission workflows.",
    )
    context_report_parser.add_argument(
        "--profile",
        required=True,
        choices=["stage-a", "po-brief", "mission-checkpoint"],
        help="Report profile.",
    )
    context_report_parser.add_argument("--scope", required=True, help="Required path, run, phase, mission, or sprint scope filter.")
    context_report_parser.add_argument("--output", required=True, help="Output path for the markdown report artifact.")
    context_report_parser.add_argument("--focus", action="append", default=[], help="Optional focus term; may be repeated.")
    context_report_parser.add_argument("--trace-id", action="append", default=[], help="Optional exact identifier to trace; may be repeated.")
    context_report_parser.add_argument("--fallback-scope", action="append", default=[], help="Optional broader scope to try after the requested scope; may be repeated.")
    context_report_parser.add_argument("--required-ref", action="append", default=[], help="Optional exact identifier or exact source path that must resolve in the final report; may be repeated.")
    context_report_parser.add_argument("--query", action="append", default=[], help="Optional extra recall query; may be repeated.")
    context_report_parser.add_argument("--limit", type=int, default=5, help="Maximum matches to include per query.")
    context_report_parser.add_argument("--db-path", default=None, help="Optional override for the SQLite index path.")
    context_report_parser.add_argument("--fail-on-weak-coverage", action="store_true", help="Exit non-zero after writing the report if coverage remains WEAK after all attempted scopes.")
    context_report_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    project_preflight_parser = subparsers.add_parser(
        "project-preflight",
        help="Run an optional declared project preflight before Factory Stage A.",
    )
    project_preflight_parser.add_argument("--run", required=True, help="Factory run ID.")
    project_preflight_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    host_capability_parser = subparsers.add_parser(
        "host-capabilities",
        help="Discover or validate schema-locked host capabilities for a Factory run.",
    )
    host_capability_parser.add_argument("--run", required=True, help="Factory run ID.")
    host_capability_parser.add_argument("--discover", action="store_true", help="Write validated Stage F capability evidence.")
    host_capability_parser.add_argument(
        "--require",
        action="append",
        nargs=3,
        default=[],
        metavar=("CAPABILITY_ID", "KIND", "ABSOLUTE_PATH"),
        help="Required capability; repeat for multiple paths.",
    )
    host_capability_parser.add_argument("--output", help="Run-relative output; must be pack/host_capabilities.json.")
    host_capability_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    execution_closeout_parser = subparsers.add_parser(
        "execution-closeout",
        help="Validate and record an authored execution-closeout outcome.",
    )
    execution_closeout_parser.add_argument("--run", required=True, help="Factory run ID.")
    execution_closeout_parser.add_argument(
        "--input",
        required=True,
        help="Path to the authored closeout JSON draft.",
    )
    execution_closeout_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    pack_lint_parser = subparsers.add_parser(
        "pack-lint",
        help="Validate a completed Factory run pack after Stage I2.",
    )
    pack_lint_group = pack_lint_parser.add_mutually_exclusive_group(required=True)
    pack_lint_group.add_argument("--run", default=None, help="Run ID or run-root path to validate.")
    pack_lint_group.add_argument("--pack", default=None, help="Direct path to a run pack directory.")
    pack_lint_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    stage_lint_parser = subparsers.add_parser(
        "stage-lint",
        help="Validate one Factory stage handoff and its expected outputs.",
    )
    stage_lint_parser.add_argument("--run", required=True, help="Run ID or run-root path to validate.")
    stage_lint_parser.add_argument(
        "--stage",
        required=True,
        choices=["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "I2"],
        help="Factory stage code to validate.",
    )
    stage_lint_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    kilo_stage_parser = subparsers.add_parser(
        "kilo-stage",
        help="Run one Factory stage through Kilo Code CLI with model routing and write-boundary checks.",
    )
    kilo_stage_parser.add_argument("--run", required=True, help="Run ID or run-root path.")
    kilo_stage_parser.add_argument(
        "--stage",
        required=True,
        choices=["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "I2"],
        help="Factory stage code to run.",
    )
    kilo_stage_parser.add_argument("--model", required=True, help="Kilo model id, for example kilo/openai/gpt-5.5.")
    kilo_stage_parser.add_argument("--variant", default=None, help="Optional model variant or reasoning effort, for example high.")
    kilo_stage_parser.add_argument("--agent", default=None, help="Optional Kilo agent name.")
    kilo_stage_parser.add_argument("--kilo-bin", default="kilo", help="Kilo CLI binary path.")
    kilo_stage_parser.add_argument("--auto", action="store_true", help="Pass --auto to Kilo for non-interactive execution.")
    kilo_stage_parser.add_argument("--timeout-seconds", type=int, default=900, help="Kilo process timeout in seconds.")
    kilo_stage_parser.add_argument(
        "--allow-nested-kilo",
        action="store_true",
        help="Allow invoking kilo-stage from inside a Kilo parent process. Not recommended.",
    )
    kilo_stage_parser.add_argument("--dry-run", action="store_true", help="Print the generated command and prompt without invoking Kilo.")
    kilo_stage_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    metrics_init_parser = subparsers.add_parser(
        "metrics-init",
        help="Create RUN_METRICS.md for a Factory run from the canonical template.",
    )
    metrics_init_parser.add_argument("--run", required=True, help="Run ID or run-root path.")
    metrics_init_parser.add_argument("--force", action="store_true", help="Overwrite an existing RUN_METRICS.md.")
    metrics_init_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    contract_lint_parser = subparsers.add_parser(
        "contract-lint",
        help="Conductor gate validation: intent (G1), execution (G2), completion (G3).",
    )
    contract_lint_parser.add_argument("gate", choices=["intent", "execution", "completion"])
    contract_lint_parser.add_argument("--run", required=True, help="Run ID under docs/Conductor/runs/.")
    contract_lint_parser.add_argument(
        "--require-complete",
        action="store_true",
        help="execution only: treat NOT_RUN checks and a missing postimage compare as errors (G2 exit).",
    )
    contract_lint_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    receipts_parser = subparsers.add_parser(
        "receipts",
        help="Run verification-manifest checks and write signed evidence receipts.",
    )
    receipts_parser.add_argument("action", choices=["run", "attest"])
    receipts_parser.add_argument("--run", required=True, help="Run ID under docs/Conductor/runs/.")
    receipts_parser.add_argument("--check", action="append", default=None, help="Limit to these check ids (run) or name the check (attest).")
    receipts_parser.add_argument("--signer", default="", help="attest only: human signer name.")
    receipts_parser.add_argument("--note", default="", help="attest only: optional note recorded in the receipt log.")
    receipts_parser.add_argument("--timeout-seconds", type=int, default=900, help="run only: per-check timeout.")
    receipts_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    postimage_parser = subparsers.add_parser(
        "postimage",
        help="Capture or compare protected-root digests for a run (write-boundary proof).",
    )
    postimage_parser.add_argument("action", choices=["capture", "compare"])
    postimage_parser.add_argument("--run", required=True, help="Run ID under docs/Conductor/runs/.")
    postimage_parser.add_argument("--root", action="append", default=None, help="capture only: protected root (repeatable); defaults to PROJECT_CONFIG.json protected_roots.")
    postimage_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    gap_parser = subparsers.add_parser(
        "gap",
        help="Open a Gap Request (agent) or record its human resolution.",
    )
    gap_parser.add_argument("action", choices=["open", "resolve"])
    gap_parser.add_argument("--run", required=True, help="Run ID under docs/Conductor/runs/.")
    gap_parser.add_argument("--requirement", help="open: Intent Pack requirement id the gap belongs to.")
    gap_parser.add_argument("--type", choices=["requirement", "architecture", "ux", "product_context", "constraint"], help="open: gap type.")
    gap_parser.add_argument("--question", help="open: the question for the upstream lane.")
    gap_parser.add_argument("--impact", choices=["active_scope", "future_only", "unknown"], default="unknown", help="open: supersession impact assessment.")
    gap_parser.add_argument("--snapshot-id", help="open: originating upstream snapshot id.")
    gap_parser.add_argument("--snapshot-sha256", help="open: originating snapshot aggregate digest.")
    gap_parser.add_argument("--proposal", help="open: optional proposed resolution (decides nothing).")
    gap_parser.add_argument("--gap", help="resolve: gap id.")
    gap_parser.add_argument("--decided-by", default="", help="resolve: human decider.")
    gap_parser.add_argument("--decision", help="resolve: decision text.")
    gap_parser.add_argument("--new-snapshot-id", help="resolve: superseding snapshot id, if any.")
    gap_parser.add_argument("--new-snapshot-sha256", help="resolve: superseding snapshot digest.")
    gap_parser.add_argument("--json", action="store_true", help="Print JSON output.")

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    root = REPO_ROOT

    try:
        if args.command == "memory-init":
            payload = bootstrap_task_memory(root=root, force=args.force)
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"Task memory initialized: {payload['journal_path']}")
                for path in payload["runbooks_written"]:
                    print(f"Runbook written: {path}")
            return 0

        if args.command == "memory-suggest":
            payload = suggest_task(root=root, task=args.task)
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(format_suggestion_text(payload))
            return 0

        if args.command == "memory-log":
            payload = log_task(
                root=root,
                task=args.task,
                outcome=args.outcome,
                notes=args.notes,
                runbook_id=args.runbook,
                duration_minutes=args.duration_minutes,
            )
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"Task memory logged: {payload['entry_id']} runbook={payload['runbook_id']} outcome={payload['outcome']}")
            return 0

        if args.command == "memory-review":
            payload = review_task_memory(root=root, write_report=not args.no_write_report)
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(payload["report"], end="")
                if payload["report_path"]:
                    print(f"\nReport written: {payload['report_path']}")
            return 0

        if args.command == "context-index":
            payload = build_context_index(root=root, db_path=Path(args.db_path) if args.db_path else None)
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"Factory context index rebuilt: {payload['db_path']}")
                print(f"Sources={payload['source_count']} Chunks={payload['chunk_count']} Facts={payload['fact_count']}")
            return 0

        if args.command == "context-recall":
            payload = recall_context(
                root=root,
                query=args.query,
                db_path=Path(args.db_path) if args.db_path else None,
                scope=args.scope,
                limit=args.limit,
            )
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(format_context_recall(payload), end="")
            return 0

        if args.command == "context-trace":
            payload = trace_context(
                root=root,
                identifier=args.id,
                db_path=Path(args.db_path) if args.db_path else None,
                scope=args.scope,
            )
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(format_context_trace(payload), end="")
            return 0

        if args.command == "context-expand":
            payload = expand_context(
                root=root,
                ref=args.ref,
                db_path=Path(args.db_path) if args.db_path else None,
            )
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(format_context_expand(payload), end="")
            return 0

        if args.command == "context-describe":
            payload = describe_context(
                root=root,
                db_path=Path(args.db_path) if args.db_path else None,
                scope=args.scope,
            )
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(format_context_describe(payload), end="")
            return 0

        if args.command == "context-report":
            payload = write_context_report(
                root=root,
                output_path=Path(args.output),
                profile=args.profile,
                scope=args.scope,
                focus_terms=args.focus,
                trace_ids=args.trace_id,
                fallback_scopes=args.fallback_scope,
                required_refs=args.required_ref,
                additional_queries=args.query,
                limit=args.limit,
                db_path=Path(args.db_path) if args.db_path else None,
                fail_on_weak_coverage=args.fail_on_weak_coverage,
            )
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"Context recall report written: {payload['output_path']}")
                print(
                    f"Profile={payload['profile']} RequestedScope={payload['requested_scope']} "
                    f"EffectiveScope={payload['effective_scope']} Coverage={payload['coverage_verdict']} "
                    f"Queries={payload['query_count']} Traces={payload['trace_count']}"
                )
            return 0

        if args.command == "project-preflight":
            payload = run_project_preflight(root=root, run_id=args.run)
            evidence_path = write_project_preflight_evidence(
                root=root,
                run_id=args.run,
                result=payload,
            )
            payload = {**payload, "evidence_path": evidence_path.relative_to(root).as_posix()}
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"project_preflight: {'PASS' if payload['outcome'] == 'pass' else 'HALT'}")
                print(f"reason_code: {payload['reason_code']}")
                print(f"evidence_path: {payload['evidence_path']}")
            return 0 if payload["outcome"] == "pass" else 1

        if args.command == "host-capabilities":
            run_root = root / "docs" / "Conductor" / "runs" / args.run
            if args.discover:
                if not args.require or not args.output:
                    payload = {
                        "status": "BLOCKED",
                        "reason_code": "CONDUCTOR_HOST_CAPABILITY_DISCOVERY_ARGUMENTS_INVALID",
                        "run_id": args.run,
                        "errors": [],
                        "mutations": [],
                    }
                else:
                    payload = discover_host_capabilities(
                        root,
                        args.run,
                        args.require,
                        args.output,
                    )
            elif args.require or args.output:
                payload = {
                    "status": "BLOCKED",
                    "reason_code": "CONDUCTOR_HOST_CAPABILITY_VALIDATION_ARGUMENTS_INVALID",
                    "run_id": args.run,
                    "errors": [],
                    "mutations": [],
                }
            else:
                payload = evaluate_host_capability_contract(root, run_root)
                payload = {**payload, "run_id": args.run, "mutations": []}
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"host_capabilities: {payload['status']}")
                print(f"reason_code: {payload['reason_code']}")
            return 0 if payload["status"] == "PASS" else 1

        if args.command == "execution-closeout":
            payload = record_closeout(
                root=root,
                run_id=args.run,
                input_path=Path(args.input),
            )
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"execution_closeout: {payload['outcome']}")
                print(f"reason_code: {payload['reason_code']}")
                print(f"evidence_path: {payload['path']}")
            return 0

        if args.command == "pack-lint":
            payload = lint_pack(
                root=root,
                run=args.run,
                pack_path=Path(args.pack) if args.pack else None,
            )
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(format_pack_lint(payload), end="")
            return 0 if payload["status"] == "PASS" else 1

        if args.command == "stage-lint":
            payload = lint_stage(root=root, run=args.run, stage=args.stage)
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(format_stage_lint(payload), end="")
            return 0 if payload["status"] == "PASS" else 1

        if args.command == "kilo-stage":
            payload = run_kilo_stage(
                root=root,
                run=args.run,
                stage=args.stage,
                model=args.model,
                variant=args.variant,
                agent=args.agent,
                kilo_bin=args.kilo_bin,
                auto=args.auto,
                timeout_seconds=args.timeout_seconds,
                dry_run=args.dry_run,
                allow_nested_kilo=args.allow_nested_kilo,
            )
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(format_kilo_stage(payload), end="")
            return 0 if payload["status"] in {"PASS", "DRY_RUN"} else 1

        if args.command == "metrics-init":
            payload = init_run_metrics(root=root, run=args.run, force=args.force)
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(format_run_metrics(payload), end="")
            return 0

        if args.command == "contract-lint":
            if args.gate == "intent":
                payload = lint_intent(root, args.run)
            elif args.gate == "execution":
                payload = lint_execution(root, args.run, require_complete=args.require_complete)
            else:
                payload = lint_completion(root, args.run)
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(format_contract_lint(payload))
            return 0 if payload["status"] == "PASS" else 1

        if args.command == "receipts":
            if args.action == "run":
                payload = run_receipts(root, args.run, check_ids=args.check, timeout_seconds=args.timeout_seconds)
            else:
                if not args.check or len(args.check) != 1:
                    raise ContractLintError("CONDUCTOR_RECEIPT_ATTEST_ARGUMENTS", "attest needs exactly one --check")
                payload = receipts_attest(root, args.run, args.check[0], args.signer, args.note)
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                if args.action == "run":
                    print("receipts: " + ", ".join(f"{k}:{v}" for k, v in payload["outcomes"].items()))
                else:
                    print(f"receipts: attested {payload['check_id']} by {payload['signer']} -> {payload['receipt']}")
            failed = any(v == "FAIL" for v in payload.get("outcomes", {}).values())
            return 1 if failed else 0

        if args.command == "gap":
            if args.action == "open":
                if not (args.requirement and args.type and args.question):
                    raise ContractLintError("CONDUCTOR_GAP_ARGUMENTS", "open needs --requirement, --type, and --question")
                payload = open_gap(root, args.run, requirement_id=args.requirement, gap_type=args.type, question=args.question,
                                   supersession_impact=args.impact, snapshot_id=args.snapshot_id, snapshot_sha256=args.snapshot_sha256,
                                   proposed_resolution=args.proposal)
            else:
                if not (args.gap and args.decision):
                    raise ContractLintError("CONDUCTOR_GAP_ARGUMENTS", "resolve needs --gap and --decision")
                payload = resolve_gap(root, args.run, args.gap, decided_by=args.decided_by, decision=args.decision,
                                      new_snapshot_id=args.new_snapshot_id, new_snapshot_sha256=args.new_snapshot_sha256)
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"gap {args.action}: {payload['gap_id']} -> {payload['path']}" + (" (G1 re-lock required)" if payload.get("g1_reopen_required") else ""))
            return 0

        if args.command == "postimage":
            payload = postimage_capture(root, args.run, args.root) if args.action == "capture" else postimage_compare(root, args.run)
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            elif args.action == "capture":
                print(f"postimage: captured {payload['file_count']} files under {payload['protected_roots']}")
            else:
                print(f"postimage: {payload['status']} changed={len(payload['changed'])} removed={len(payload['removed'])} added={len(payload['added'])}")
            return 0 if payload.get("status", "PASS") == "PASS" else 1

    except (
        ContractLintError,
        FactoryContextIndexError,
        ExecutionCloseoutError,
        FactoryKiloStageError,
        FactoryPackLintError,
        ProjectPreflightError,
        FactoryRunMetricsError,
        FactoryStageLintError,
        TaskMemoryError,
    ) as exc:
        print(f"ERROR: {exc}")
        return 2

    parser.print_help()
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
