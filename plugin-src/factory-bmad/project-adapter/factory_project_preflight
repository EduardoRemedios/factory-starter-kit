#!/usr/bin/env python3
"""Fail-closed Factory project preflight for promoted BMAD evidence."""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import re
import stat
import sys
from pathlib import Path

sys.dont_write_bytecode = True


RUN_RE = re.compile(r"RUN_\d{8}_\d{4}_[A-Za-z0-9_-]+")
SNAPSHOT_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{2,63}")
HEX_RE = re.compile(r"[0-9a-f]{64}")
RESERVED_SNAPSHOT_IDS = frozenset({"latest", "receipts", "install-receipts"})
SNAPSHOT_MANIFEST_MODE = 0o644
SOLUTION_CONTEXT_SCHEMA_VERSION = 2
SOLUTION_CONTEXT_TYPE = "SOLUTION_CONTEXT"
EVIDENCE_ONLY = "EVIDENCE_ONLY"
CLAIM_OUTCOMES = frozenset({"ACCEPTED", "REJECTED", "MODIFIED", "DEFERRED", "CONFLICT"})


def load_policy():
    candidates = (
        Path(__file__).with_name("factory_bmad_policy.py"),
        Path(__file__).parent.parent / "runtime" / "factory_bmad_policy.py",
    )
    path = next((candidate for candidate in candidates if candidate.is_file()), None)
    if path is None:
        return None
    spec = importlib.util.spec_from_file_location("factory_bmad_project_policy", path)
    if spec is None or spec.loader is None:
        return None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def aggregate(manifest: dict[str, object]) -> str:
    core = {key: value for key, value in manifest.items() if key != "aggregate_sha256"}
    encoded = json.dumps(core, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
    return hashlib.sha256(encoded).hexdigest()


def result(status: str, code: str, paths: list[str]) -> dict[str, object]:
    return {
        "schema_version": 1,
        "status": status,
        "reason_code": code,
        "evidence_paths": paths,
    }


def fields(text: str, label: str) -> list[str]:
    return [match.strip() for match in re.findall(rf"^- {re.escape(label)}:\s*`?([^`\n]+)`?\s*$", text, re.MULTILINE)]


def safe_run_receipt(root: Path, run_id: str, value: str) -> Path | None:
    relative = Path(value)
    prefix = Path("docs/Factory/runs") / run_id
    if relative.is_absolute() or ".." in relative.parts or relative.parts[: len(prefix.parts)] != prefix.parts:
        return None
    cursor = root
    for part in relative.parts:
        cursor /= part
        if cursor.is_symlink():
            return None
    return root / relative


def validate_claim_receipt(root: Path, run_id: str, value: str, snapshot_id: str, digest: str, evidence: list[str]) -> str | None:
    if value == "PENDING_STAGE_A_D":
        return None
    receipt_path = safe_run_receipt(root, run_id, value)
    if receipt_path is None or not receipt_path.is_file():
        return "FACTORY_BMAD_CLAIM_RECEIPT_INVALID"
    evidence.append(receipt_path.relative_to(root).as_posix())
    try:
        receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return "FACTORY_BMAD_CLAIM_RECEIPT_INVALID"
    expected_keys = {"schema_version", "receipt_type", "snapshot", "claims", "aggregate_sha256"}
    if not isinstance(receipt, dict) or set(receipt) != expected_keys or receipt.get("schema_version") != 1 or receipt.get("receipt_type") != "BMAD_CLAIM_DISPOSITIONS":
        return "FACTORY_BMAD_CLAIM_RECEIPT_INVALID"
    if aggregate(receipt) != receipt.get("aggregate_sha256"):
        return "FACTORY_BMAD_CLAIM_RECEIPT_HASH_MISMATCH"
    snapshot = receipt.get("snapshot")
    expected_snapshot = {"snapshot_id": snapshot_id, "aggregate_sha256": digest, "path": f"docs/upstream/bmad/{snapshot_id}"}
    if snapshot != expected_snapshot:
        return "FACTORY_BMAD_CLAIM_RECEIPT_SNAPSHOT_MISMATCH"
    claims = receipt.get("claims")
    required = {"claim_id", "outcome", "rationale", "intent_reference", "reviewer", "conflict_or_supersession"}
    if not isinstance(claims, list) or not claims:
        return "FACTORY_BMAD_CLAIM_RECEIPT_INVALID"
    claim_ids: set[str] = set()
    for claim in claims:
        if not isinstance(claim, dict) or set(claim) != required or any(not isinstance(claim[key], str) or not claim[key].strip() for key in required):
            return "FACTORY_BMAD_CLAIM_RECEIPT_INVALID"
        if claim["claim_id"] in claim_ids:
            return "FACTORY_BMAD_CLAIM_RECEIPT_DUPLICATE"
        claim_ids.add(claim["claim_id"])
        if claim["outcome"] not in CLAIM_OUTCOMES:
            return "FACTORY_BMAD_CLAIM_OUTCOME_INVALID"
        link = claim["conflict_or_supersession"]
        if claim["outcome"] == "CONFLICT" and link == "NONE":
            return "FACTORY_BMAD_CLAIM_CONFLICT_LINK_MISSING"
        if claim["outcome"] != "CONFLICT" and link != "NONE":
            return "FACTORY_BMAD_CLAIM_LINK_INVALID"
    return None


def validate_solution_context(root: Path, run_id: str, manifest: dict[str, object], snapshot: Path, text: str, digest: str, policy_module: object, evidence: list[str]) -> str | None:
    exact = {"schema_version", "snapshot_id", "evidence_type", "authority", "policy_version", "artifacts", "review", "provenance", "aggregate_sha256"}
    if "supersedes" in manifest:
        exact.add("supersedes")
    if set(manifest) != exact:
        return "FACTORY_BMAD_MANIFEST_INVALID"
    evidence_type = fields(text, "BMAD Evidence Type")[0]
    policy_version = fields(text, "BMAD Policy Version")[0]
    promotion_plan_id = fields(text, "BMAD Promotion Plan ID")[0]
    plan_identity = fields(text, "BMAD Solution Plan Identity")[0]
    claim_receipt = fields(text, "BMAD Claim Receipt")[0]
    if evidence_type != SOLUTION_CONTEXT_TYPE or manifest.get("evidence_type") != SOLUTION_CONTEXT_TYPE:
        return "FACTORY_BMAD_EVIDENCE_TYPE_INVALID"
    if manifest.get("authority") != EVIDENCE_ONLY:
        return "FACTORY_BMAD_AUTHORITY_INVALID"
    if policy_version != policy_module.POLICY_VERSION or manifest.get("policy_version") != policy_module.POLICY_VERSION:
        return "FACTORY_BMAD_SNAPSHOT_POLICY_VERSION_MISMATCH"
    review = manifest.get("review")
    review_keys = {"decision", "reviewer", "reference"}
    if isinstance(review, dict) and "qualifier" in review:
        review_keys.add("qualifier")
    if not isinstance(review, dict) or set(review) != review_keys or review.get("decision") != "APPROVED" or not review.get("reviewer") or not review.get("reference"):
        return "FACTORY_BMAD_REVIEW_EVIDENCE_INVALID"
    review_qualifier = fields(text, "BMAD Review Qualifier")
    if review.get("qualifier") != (review_qualifier[0] if review_qualifier else None):
        return "FACTORY_BMAD_REVIEW_QUALIFIER_MISMATCH"
    provenance = manifest.get("provenance")
    provenance_keys = {"system", "bmad_version", "workflow", "promotion_plan_id", "plan_identity", "source_root", "source_aggregate_sha256"}
    if not isinstance(provenance, dict) or set(provenance) != provenance_keys:
        return "FACTORY_BMAD_PROVENANCE_INVALID"
    if provenance.get("system") != "BMAD" or provenance.get("bmad_version") != policy_module.SUPPORTED_BMAD_VERSION:
        return "FACTORY_BMAD_PROVENANCE_INVALID"
    if provenance.get("promotion_plan_id") != promotion_plan_id or provenance.get("plan_identity") != plan_identity:
        return "FACTORY_BMAD_PROMOTION_IDENTITY_MISMATCH"
    source_root = provenance.get("source_root")
    if not isinstance(source_root, str) or Path(source_root).is_absolute() or ".." in Path(source_root).parts or Path(source_root).parts[:1] != ("_bmad-output",):
        return "FACTORY_BMAD_PROVENANCE_INVALID"
    workflow = provenance.get("workflow")
    if not isinstance(workflow, str) or not policy_module.policy_classify(f"bmad-{workflow}")["allowed"]:
        return "FACTORY_BMAD_PROHIBITED_AUTHORITY"
    artifacts = manifest.get("artifacts")
    if not isinstance(artifacts, dict) or not artifacts:
        return "FACTORY_BMAD_ARTIFACT_INVALID"
    if provenance.get("source_aggregate_sha256") != hashlib.sha256(json.dumps(artifacts, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest():
        return "FACTORY_BMAD_PROVENANCE_INVALID"
    expected_paths = {"SNAPSHOT_MANIFEST.json"}
    for name, artifact in artifacts.items():
        path = Path(name) if isinstance(name, str) else Path("/")
        artifact_keys = {"mode", "sha256", "source_path", "source_sha256"}
        if path.is_absolute() or ".." in path.parts or path.parts[:1] != ("content",) or not isinstance(artifact, dict) or set(artifact) != artifact_keys:
            return "FACTORY_BMAD_ARTIFACT_INVALID"
        source_path = artifact.get("source_path")
        if not isinstance(source_path, str) or Path(source_path).is_absolute() or ".." in Path(source_path).parts:
            return "FACTORY_BMAD_ARTIFACT_INVALID"
        if not isinstance(artifact.get("mode"), int) or not HEX_RE.fullmatch(str(artifact.get("sha256"))) or artifact.get("source_sha256") != artifact.get("sha256"):
            return "FACTORY_BMAD_ARTIFACT_INVALID"
        expected_paths.add(name)
    try:
        actual: dict[str, object] = {}
        for path in snapshot.rglob("*"):
            metadata = path.lstat()
            relative = path.relative_to(snapshot).as_posix()
            if stat.S_ISDIR(metadata.st_mode):
                continue
            if not stat.S_ISREG(metadata.st_mode):
                return "FACTORY_BMAD_SNAPSHOT_INVENTORY_INVALID"
            actual[relative] = metadata
    except OSError:
        return "FACTORY_BMAD_SNAPSHOT_INVENTORY_INVALID"
    if set(actual) != expected_paths or stat.S_IMODE(actual["SNAPSHOT_MANIFEST.json"].st_mode) != SNAPSHOT_MANIFEST_MODE:
        return "FACTORY_BMAD_SNAPSHOT_INVENTORY_INVALID"
    for name, artifact in artifacts.items():
        if stat.S_IMODE(actual[name].st_mode) != artifact["mode"]:
            return "FACTORY_BMAD_ARTIFACT_MODE_MISMATCH"
        if sha256(snapshot / name) != artifact["sha256"]:
            return "FACTORY_BMAD_ARTIFACT_HASH_MISMATCH"
        evidence.append((snapshot / name).relative_to(root).as_posix())
    supersedes = manifest.get("supersedes")
    if supersedes is not None:
        if not isinstance(supersedes, dict) or set(supersedes) != {"snapshot_id", "aggregate_sha256"}:
            return "FACTORY_BMAD_SUPERSESSION_INVALID"
        previous_id = supersedes.get("snapshot_id")
        previous_digest = supersedes.get("aggregate_sha256")
        if not isinstance(previous_id, str) or not SNAPSHOT_RE.fullmatch(previous_id) or previous_id == manifest.get("snapshot_id") or not HEX_RE.fullmatch(str(previous_digest)):
            return "FACTORY_BMAD_SUPERSESSION_INVALID"
        try:
            previous = json.loads((root / "docs/upstream/bmad" / previous_id / "SNAPSHOT_MANIFEST.json").read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError):
            return "FACTORY_BMAD_SUPERSESSION_INVALID"
        if not isinstance(previous, dict) or previous.get("aggregate_sha256") != previous_digest:
            return "FACTORY_BMAD_SUPERSESSION_INVALID"
    return validate_claim_receipt(root, run_id, claim_receipt, str(manifest["snapshot_id"]), digest, evidence)


def canonical_workflow_name(policy_module, workflow: object) -> str | None:
    if not isinstance(workflow, str):
        return None
    value = workflow.strip().removeprefix("/")
    if not value:
        return None
    if policy_module.canonical_bmad_name(value):
        return value
    return policy_module.canonical_bmad_name(f"bmad-{value}")


def validate(root: Path, run_id: str) -> dict[str, object]:
    brief = root / "docs" / "Factory" / "runs" / run_id / "raw_brief.md"
    policy = root / "docs" / "adapters" / "bmad" / "BMAD_POLICY.md"
    evidence = [brief.relative_to(root).as_posix(), policy.relative_to(root).as_posix()]
    if not brief.is_file():
        return result("FAIL", "FACTORY_BMAD_BRIEF_MISSING", [policy.relative_to(root).as_posix()] if policy.is_file() else [])
    if not policy.is_file() or policy.is_symlink():
        return result("FAIL", "FACTORY_BMAD_POLICY_MISSING", [brief.relative_to(root).as_posix()])
    policy_module = load_policy()
    if policy_module is None:
        return result("FAIL", "FACTORY_BMAD_POLICY_MISSING", evidence)
    lint = policy_module.policy_lint(root, "claude")
    if lint["state"] != "READY":
        return result("FAIL", lint["reason_code"], evidence)
    audit_path = root / "docs/adapters/bmad/CAPABILITY_AUDIT.json"
    reconciliation_path = root / "docs/adapters/bmad/BMAD_RECONCILIATION.json"
    if not audit_path.is_file() or audit_path.is_symlink():
        return result("FAIL", "FACTORY_BMAD_CAPABILITY_AUDIT_MISSING", evidence)
    if not reconciliation_path.is_file() or reconciliation_path.is_symlink():
        return result("FAIL", "FACTORY_BMAD_RECONCILIATION_MISSING", evidence)
    evidence.extend([audit_path.relative_to(root).as_posix(), reconciliation_path.relative_to(root).as_posix()])
    try:
        recorded_audit = json.loads(audit_path.read_text(encoding="utf-8"))
        recorded_reconciliation = json.loads(reconciliation_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return result("FAIL", "FACTORY_BMAD_CAPABILITY_AUDIT_INVALID", evidence)
    if not isinstance(recorded_audit, dict) or recorded_audit.get("policy_version") != policy_module.POLICY_VERSION:
        return result("FAIL", "FACTORY_BMAD_POLICY_VERSION_DRIFT", evidence)
    if recorded_audit.get("status") != "READY" or recorded_audit.get("reason_code") != lint["reason_code"]:
        return result("FAIL", "FACTORY_BMAD_CAPABILITY_AUDIT_INVALID", evidence)
    if recorded_audit.get("coverage_sha256") != lint["coverage_sha256"]:
        return result("FAIL", "FACTORY_BMAD_CAPABILITY_AUDIT_DRIFT", evidence)
    if not isinstance(recorded_reconciliation, dict) or recorded_reconciliation.get("policy_version") != policy_module.POLICY_VERSION:
        return result("FAIL", "FACTORY_BMAD_RECONCILIATION_DRIFT", evidence)
    reconciliation_core = {key: value for key, value in recorded_reconciliation.items() if key != "aggregate_sha256"}
    if recorded_reconciliation.get("aggregate_sha256") != policy_module.digest_bytes(policy_module.canonical(reconciliation_core)):
        return result("FAIL", "FACTORY_BMAD_RECONCILIATION_DRIFT", evidence)
    try:
        text = brief.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return result("FAIL", "FACTORY_BMAD_BRIEF_UNREADABLE", evidence)
    if "_bmad-output/" in text:
        return result("FAIL", "FACTORY_BMAD_DRAFT_CITATION", evidence)
    labels = (
        "BMAD Snapshot ID", "BMAD Snapshot SHA-256", "BMAD Authority", "BMAD Context Freeze",
        "BMAD Review Qualifier", "BMAD Evidence Type", "BMAD Policy Version",
        "BMAD Promotion Plan ID", "BMAD Solution Plan Identity", "BMAD Claim Receipt",
    )
    parsed = {label: fields(text, label) for label in labels}
    if any(len(values) > 1 for values in parsed.values()):
        return result("FAIL", "FACTORY_BMAD_BRIEF_FIELD_DUPLICATE", evidence)
    snapshot_id = parsed["BMAD Snapshot ID"][0] if parsed["BMAD Snapshot ID"] else None
    digest = parsed["BMAD Snapshot SHA-256"][0] if parsed["BMAD Snapshot SHA-256"] else None
    authority = parsed["BMAD Authority"][0] if parsed["BMAD Authority"] else None
    freeze = parsed["BMAD Context Freeze"][0] if parsed["BMAD Context Freeze"] else None
    review_qualifier = parsed["BMAD Review Qualifier"][0] if parsed["BMAD Review Qualifier"] else None
    if not snapshot_id or not SNAPSHOT_RE.fullmatch(snapshot_id):
        return result("FAIL", "FACTORY_BMAD_SNAPSHOT_ID_INVALID", evidence)
    if snapshot_id.casefold() in RESERVED_SNAPSHOT_IDS:
        return result("FAIL", "FACTORY_BMAD_SNAPSHOT_ID_RESERVED", evidence)
    if not digest or not HEX_RE.fullmatch(digest):
        return result("FAIL", "FACTORY_BMAD_SNAPSHOT_DIGEST_INVALID", evidence)
    if authority != "EVIDENCE_ONLY":
        return result("FAIL", "FACTORY_BMAD_AUTHORITY_INVALID", evidence)
    if freeze != "Brief Purple PASS":
        return result("FAIL", "FACTORY_BMAD_CONTEXT_NOT_FROZEN", evidence)
    snapshot = root / "docs" / "upstream" / "bmad" / snapshot_id
    manifest_path = snapshot / "SNAPSHOT_MANIFEST.json"
    if snapshot.is_symlink() or not manifest_path.is_file() or manifest_path.is_symlink():
        return result("FAIL", "FACTORY_BMAD_SNAPSHOT_MISSING", evidence)
    evidence.append(manifest_path.relative_to(root).as_posix())
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return result("FAIL", "FACTORY_BMAD_MANIFEST_INVALID", evidence)
    if not isinstance(manifest, dict):
        return result("FAIL", "FACTORY_BMAD_MANIFEST_INVALID", evidence)
    schema_version = manifest.get("schema_version")
    if schema_version not in {1, SOLUTION_CONTEXT_SCHEMA_VERSION} or manifest.get("snapshot_id") != snapshot_id:
        return result("FAIL", "FACTORY_BMAD_MANIFEST_ID_MISMATCH", evidence)
    if manifest.get("aggregate_sha256") != digest:
        return result("FAIL", "FACTORY_BMAD_CITATION_HASH_MISMATCH", evidence)
    if aggregate(manifest) != digest:
        return result("FAIL", "FACTORY_BMAD_MANIFEST_HASH_MISMATCH", evidence)
    solution_labels = ("BMAD Evidence Type", "BMAD Policy Version", "BMAD Promotion Plan ID", "BMAD Solution Plan Identity", "BMAD Claim Receipt")
    if schema_version == SOLUTION_CONTEXT_SCHEMA_VERSION:
        if any(len(parsed[label]) != 1 for label in solution_labels):
            return result("FAIL", "FACTORY_BMAD_SOLUTION_CONTEXT_FIELDS_MISSING", evidence)
        code = validate_solution_context(root, run_id, manifest, snapshot, text, digest, policy_module, evidence)
        if code is not None:
            return result("FAIL", code, evidence)
        return result("PASS", "FACTORY_BMAD_PREFLIGHT_PASS", evidence)
    if any(parsed[label] for label in solution_labels):
        return result("FAIL", "FACTORY_BMAD_EVIDENCE_TYPE_INVALID", evidence)
    required = {"schema_version", "snapshot_id", "aggregate_sha256", "artifact", "review", "provenance"}
    if not required.issubset(manifest):
        return result("FAIL", "FACTORY_BMAD_MANIFEST_INVALID", evidence)
    artifact = manifest.get("artifact")
    review = manifest.get("review")
    if not isinstance(artifact, dict) or not isinstance(review, dict):
        return result("FAIL", "FACTORY_BMAD_REVIEW_EVIDENCE_INVALID", evidence)
    if not review.get("reviewer") or not review.get("reference") or review.get("decision") != "APPROVED":
        return result("FAIL", "FACTORY_BMAD_REVIEW_EVIDENCE_INVALID", evidence)
    manifest_qualifier = review.get("qualifier")
    if manifest_qualifier is not None and (
        not isinstance(manifest_qualifier, str)
        or not manifest_qualifier.strip()
        or manifest_qualifier != review_qualifier
    ):
        return result("FAIL", "FACTORY_BMAD_REVIEW_QUALIFIER_MISMATCH", evidence)
    if manifest_qualifier is None and review_qualifier is not None:
        return result("FAIL", "FACTORY_BMAD_REVIEW_QUALIFIER_MISMATCH", evidence)
    name = artifact.get("path")
    expected = artifact.get("sha256")
    expected_mode = artifact.get("mode")
    if not isinstance(name, str) or Path(name).name != name or not isinstance(expected, str) or not isinstance(expected_mode, int):
        return result("FAIL", "FACTORY_BMAD_ARTIFACT_INVALID", evidence)
    artifact_path = snapshot / name
    try:
        entries = {path.name: path.lstat() for path in snapshot.iterdir()}
    except OSError:
        return result("FAIL", "FACTORY_BMAD_SNAPSHOT_INVENTORY_INVALID", evidence)
    if set(entries) != {"SNAPSHOT_MANIFEST.json", name} or any(not stat.S_ISREG(metadata.st_mode) for metadata in entries.values()):
        return result("FAIL", "FACTORY_BMAD_SNAPSHOT_INVENTORY_INVALID", evidence)
    if stat.S_IMODE(entries["SNAPSHOT_MANIFEST.json"].st_mode) != SNAPSHOT_MANIFEST_MODE:
        return result("FAIL", "FACTORY_BMAD_SNAPSHOT_INVENTORY_INVALID", evidence)
    if stat.S_IMODE(entries[name].st_mode) != expected_mode:
        return result("FAIL", "FACTORY_BMAD_ARTIFACT_MODE_MISMATCH", evidence)
    if sha256(artifact_path) != expected:
        return result("FAIL", "FACTORY_BMAD_ARTIFACT_HASH_MISMATCH", evidence)
    provenance = manifest.get("provenance")
    workflow = provenance.get("workflow") if isinstance(provenance, dict) else None
    workflow_name = canonical_workflow_name(policy_module, workflow)
    if not policy_module.policy_classify(workflow_name)["allowed"]:
        return result("FAIL", "FACTORY_BMAD_PROHIBITED_AUTHORITY", evidence)
    evidence.append(artifact_path.relative_to(root).as_posix())
    return result("PASS", "FACTORY_BMAD_PREFLIGHT_PASS", evidence)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--run", required=True)
    parser.add_argument("--json", action="store_true", required=True)
    args = parser.parse_args()
    if not RUN_RE.fullmatch(args.run):
        payload = result("FAIL", "FACTORY_BMAD_RUN_ID_INVALID", [])
    else:
        payload = validate(Path.cwd().resolve(), args.run)
    print(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
