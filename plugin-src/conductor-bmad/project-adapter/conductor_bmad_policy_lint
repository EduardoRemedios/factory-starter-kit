#!/usr/bin/env python3
"""CI-callable Factory BMAD policy lint using the shared authored policy."""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True

import conductor_bmad_policy


def main() -> int:
    payload = conductor_bmad_policy.policy_lint(Path.cwd().resolve(), "claude")
    print(json.dumps(payload, sort_keys=True))
    return 0 if payload["state"] == "READY" else 2


if __name__ == "__main__":
    sys.exit(main())
