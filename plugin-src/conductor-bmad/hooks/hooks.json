{
  "description": "Enforce the Factory BMAD upstream-only authority boundary.",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/conductor_bmad.py\" hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/conductor_bmad.py\" hook"
          }
        ]
      }
    ]
  }
}
