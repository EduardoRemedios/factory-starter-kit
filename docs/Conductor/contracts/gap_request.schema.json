{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.dev/schemas/gap_request.schema.json",
  "title": "Conductor Gap Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gap_id", "run_id", "intent_pack_sha256", "requirement_id", "gap_type", "question", "supersession_impact"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "gap_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "intent_pack_sha256": { "$ref": "#/$defs/sha256" },
    "origin_snapshot_id": { "$ref": "#/$defs/id" },
    "origin_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "requirement_id": { "$ref": "#/$defs/id" },
    "gap_type": { "enum": ["requirement", "architecture", "ux", "product_context", "constraint"] },
    "question": { "type": "string", "minLength": 1 },
    "proposed_resolution": { "type": "string" },
    "supersession_impact": { "enum": ["active_scope", "future_only", "unknown"] },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["decided_by", "utc", "decision"],
      "properties": {
        "decided_by": { "type": "string", "minLength": 1 },
        "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
        "decision": { "type": "string", "minLength": 1 },
        "new_snapshot_id": { "$ref": "#/$defs/id" },
        "new_snapshot_sha256": { "$ref": "#/$defs/sha256" }
      },
      "dependentRequired": { "new_snapshot_id": ["new_snapshot_sha256"], "new_snapshot_sha256": ["new_snapshot_id"] }
    }
  },
  "dependentRequired": { "origin_snapshot_id": ["origin_snapshot_sha256"], "origin_snapshot_sha256": ["origin_snapshot_id"] }
}
