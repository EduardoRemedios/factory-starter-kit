{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductor.dev/schemas/project_config.schema.json",
  "title": "Conductor Project Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_name", "bmad", "protected_roots", "allowed_harnesses", "default_budget", "agents_md", "required_docs", "recall"],
  "$defs": {
    "relpath": { "type": "string", "pattern": "^(?!/)(?!docs/)(?!.*(^|/)\\.\\.(/|$))[^\\s]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "product_name": { "type": "string", "minLength": 1 },
    "bmad": {
      "type": "object", "additionalProperties": false,
      "required": ["legacy_evidence_root"],
      "properties": {
        "declared_root": { "$ref": "#/$defs/relpath", "default": "_bmad",
          "description": "Exactly one active BMAD root. Must contain _config/manifest.yaml, contain no symlink components, and must not be under docs/." },
        "legacy_evidence_root": { "type": "string", "const": "docs/adapters/bmad/legacy-evidence" }
      }
    },
    "protected_roots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowed_harnesses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["claude-code", "codex", "cursor"] } },
    "default_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "effort_g2", "effort_g3"],
      "properties": { "model": { "type": "string", "minLength": 1 }, "effort_g2": { "$ref": "#/$defs/effort" }, "effort_g3": { "$ref": "#/$defs/effort" } }
    },
    "agents_md": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["managed_block", "full_ownership"] },
        "project_owned_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "required_docs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "project_preflight": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" }, "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 } }
    },
    "recall": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger"],
      "properties": { "trigger": { "enum": ["always", "when_index_nonempty", "never"] } }
    }
  }
}
